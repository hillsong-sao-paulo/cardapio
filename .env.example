# NocoDB (frontend - prefixe com VITE_ para expor no browser)
VITE_NOCODB_URL=https://sua-instancia.nocodb.com
VITE_NOCODB_API_TOKEN=
VITE_NOCODB_BASE_ID=
# JSON: table name -> table id (m_xxx). Obtenha os IDs na URL ao abrir cada tabela no NocoDB.
VITE_NOCODB_TABLE_IDS={"categories":"","admin_users":"","menu_items":"","sales":"","sale_items":"","kitchen_orders":"","kitchen_order_items":""}

# NocoDB (backend - só usado nas API routes no Vercel; não use VITE_ aqui)
NOCODB_URL=
NOCODB_API_TOKEN=
NOCODB_BASE_ID=
NOCODB_TABLE_IDS={"admin_users":""}
